#!/bin/sh
# Regenerate the shipped translations from translations_src and stage them.
# Enable once per clone with: git config core.hooksPath .githooks

if ! git diff --cached --name-only | grep -q '^translations_src/'; then
    exit 0
fi

PYTHON=$(command -v python3 || command -v python) || {
    echo "pre-commit: python not found, cannot regenerate translations" >&2
    exit 1
}

"$PYTHON" scripts/generate_translations.py >/dev/null || exit 1
git add custom_components/feels_like/translations
